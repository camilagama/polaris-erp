{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env*", "knip.config.ts"],
  "globalEnv": [
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NODE_ENV",
    "R2_PUBLIC_BASE_URL",
    "SENTRY_DSN",
    "VERCEL_ENV"
  ],
  "globalPassThroughEnv": [
    "ALLOW_PLAYWRIGHT_BOOTSTRAP",
    "ADMIN_DEPLOYMENT_SMOKE_PROTECTED",
    "ADMIN_DEPLOYMENT_SMOKE_URL",
    "ADMIN_APP_URL",
    "ASAAS_API_BASE_URL",
    "ASAAS_API_KEY",
    "ASAAS_WEBHOOK_TOKEN",
    "BETTER_AUTH_API_KEY",
    "BETTER_AUTH_SECRET",
    "DATABASE_POOL_MAX",
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "DEPLOYMENT_SMOKE_URL",
    "E2E_DATABASE_URL",
    "E2E_INTERNAL_BOOTSTRAP_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "INTERNAL_BOOTSTRAP_SECRET",
    "INTERNAL_R2_HEALTH_SECRET",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "PRODUCT_IMAGE_RECONCILE_SECRET",
    "PERFORMANCE_MIN_ROWS",
    "PERFORMANCE_ORGANIZATION_ID",
    "PERFORMANCE_REQUIRE_REPRESENTATIVE",
    "PERFORMANCE_SEARCH_TERM",
    "PERFORMANCE_USER_ID",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_WEBHOOK_SECRET",
    "SUPPORT_EMAIL",
    "R2_ACCESS_KEY_ID",
    "R2_ACCOUNT_ID",
    "R2_BUCKET_PUBLIC",
    "R2_BUCKET_STAGING",
    "R2_SECRET_ACCESS_KEY",
    "RLS_DATABASE_URL",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_TRACES_SAMPLE_RATE",
    "NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE",
    "NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE",
    "NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "WOOVI_API_BASE_URL",
    "WOOVI_API_KEY",
    "WOOVI_WEBHOOK_SECRET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "fix": {
      "cache": false
    },
    "knip": {
      "dependsOn": ["^knip"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "prod:preflight": {
      "cache": false
    },
    "deploy:smoke": {
      "cache": false
    },
    "db:smoke:rls": {
      "cache": false
    },
    "db:analyze:listings": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "name": "@polaris/admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@polaris/auth": "workspace:*",
    "@polaris/date": "workspace:*",
    "@polaris/db": "workspace:*",
    "@polaris/e2e-support": "workspace:*",
    "@polaris/platform": "workspace:*",
    "@polaris/platform-auth": "workspace:*",
    "@polaris/ui": "workspace:*",
    "@sentry/nextjs": "^10.63.0",
    "@tanstack/react-table": "^8.21.3"
  },
  "scripts": {
    "dev": "bun ../../scripts/run-next-with-local-env.ts admin dev --port 3001",
    "build": "bun ../../scripts/run-next-with-local-env.ts admin build",
    "start": "bun ../../scripts/run-next-with-local-env.ts admin start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check": "cd ../.. && bun x ultracite check",
    "deploy:smoke": "bun ../../scripts/smoke-admin-deployment.ts",
    "test:e2e": "bun ../../scripts/check-e2e-db-schema.ts && bun x playwright test --config=playwright.config.ts"
  }
}

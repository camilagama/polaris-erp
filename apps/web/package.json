{
  "name": "@polaris/web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@polaris/billing": "workspace:*",
    "@polaris/emails": "workspace:*"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env.local x next dev",
    "build": "bun --env-file=../../.env.local x next build",
    "start": "bun --env-file=../../.env.local x next start",
    "test": "vitest run",
    "test:e2e": "bun ../../scripts/check-e2e-db-schema.ts && playwright test",
    "check": "cd ../.. && bun x ultracite check",
    "fix": "cd ../.. && bun x ultracite fix",
    "knip": "cd ../.. && bun x knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "prod:preflight": "bun ../../scripts/check-production-readiness.ts",
    "deploy:smoke": "bun ../../scripts/smoke-deployment.ts",
    "db:smoke:rls": "bun ../../scripts/smoke-rls-runtime.cjs",
    "db:analyze:listings": "bun ../../scripts/analyze-listing-plans.ts",
    "db:studio": "drizzle-kit studio"
  }
}

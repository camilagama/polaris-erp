{
  "name": "@polaris/web",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@polaris/billing": "workspace:*",
    "@polaris/db": "workspace:*",
    "@polaris/events": "workspace:*",
    "@polaris/emails": "workspace:*",
    "@polaris/e2e-support": "workspace:*",
    "@polaris/auth": "workspace:*",
    "@polaris/ui": "workspace:*"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env.local x next dev --port 3000",
    "build": "bun --env-file=../../.env.local x next build",
    "start": "bun --env-file=../../.env.local x next start",
    "test": "vitest run",
    "test:postgres": "bun ../../scripts/require-postgres-behavior-database.ts && vitest run src/integrations/asaas/billing-reconciliation.postgres.test.ts",
    "test:e2e": "bun ../../scripts/check-e2e-db-schema.ts && playwright test",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "check": "cd ../.. && bun x ultracite check",
    "fix": "cd ../.. && bun x ultracite fix",
    "knip": "cd ../.. && bun x knip",
    "db:generate": "bun run --cwd ../../packages/db db:generate",
    "db:migrate": "bun run --cwd ../../packages/db db:migrate",
    "db:push": "bun run --cwd ../../packages/db db:push",
    "prod:preflight": "bun ../../scripts/check-production-readiness.ts",
    "deploy:smoke": "bun ../../scripts/smoke-deployment.ts",
    "db:smoke:rls": "bun ../../scripts/smoke-rls-runtime.cjs",
    "db:analyze:listings": "bun ../../scripts/analyze-listing-plans.ts",
    "db:studio": "bun run --cwd ../../packages/db db:studio"
  }
}

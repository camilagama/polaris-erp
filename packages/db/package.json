{
  "name": "@polaris/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pool-config": "./src/pool-config.ts",
    "./schema": "./src/schema.ts",
    "./tenant-context": "./src/tenant-context.ts",
    "./opaque-cursor": "./src/opaque-cursor.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun ../../scripts/require-database-url-direct.ts && drizzle-kit migrate",
    "db:push": "bun ../../scripts/check-local-db-push-target.ts && drizzle-kit push --config=drizzle.push.config.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:postgres": "bun ../../scripts/require-postgres-behavior-database.ts && vitest run src/postgres-behavior.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:platform-postgres": "bun scripts/prepare-and-run-platform-postgres.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}

# ==============================================================================
# Configurações de Ambiente (Environment)
# Copie este arquivo para .env.local e preencha os valores.
# AVISO: Nunca comite arquivos .env.local ou que contenham segredos reais.
# ==============================================================================

# Define o ambiente da aplicação (development, test, production)
NODE_ENV="development"

# Ambiente Vercel quando rodando em deploy (development, preview, production)
VERCEL_ENV=""

# URL base da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# URL dedicada do admin interno. Em producao, use origem separada do app publico.
ADMIN_APP_URL=""

# ==============================================================================
# Banco de Dados (Neon Postgres)
# Obtenha a connection string em: https://console.neon.tech
# Navegue até Dashboard > Connection string > Copy
# ==============================================================================

# URL de conexao com pgbouncer (Connection Pooling) - Usada pelo runtime da aplicacao.
# Em producao, use role nao proprietaria sem BYPASSRLS (ex.: polaris_app)
# e inclua sslmode=verify-full.
DATABASE_URL=""

# Limite por instancia do pg.Pool usado pelo runtime. Default conservador: 3.
# Em serverless, mantenha baixo para evitar multiplicar conexoes por instancia.
DATABASE_POOL_MAX=""

# URL de conexao direta - Usada para migrations do Drizzle (sem pooling).
# Em producao, use a role proprietaria/admin de migration (ex.: neondb_owner)
# e inclua sslmode=verify-full.
DATABASE_URL_DIRECT=""

# URL de banco isolado para Playwright/E2E. Use branch dedicada; nunca producao.
# Em CI/producao, inclua sslmode=verify-full.
E2E_DATABASE_URL=""

# URL runtime usada pelo job manual rls-smoke. Deve usar role sem BYPASSRLS.
# Deve ser diferente de E2E_DATABASE_URL e incluir sslmode=verify-full.
RLS_DATABASE_URL=""

# ==============================================================================
# Analise de planos de listagem (somente leitura em branch representativa)
# ==============================================================================

# Tenant usado por `bun run db:analyze:listings`.
PERFORMANCE_ORGANIZATION_ID=""

# Opcional. Quando preenchido, valida tambem buscas por produto/cliente.
PERFORMANCE_SEARCH_TERM=""

# Opcional. Define app.user_id para politicas que dependam do usuario.
PERFORMANCE_USER_ID=""

# Minimo de linhas por consulta para considerar o plano representativo.
PERFORMANCE_MIN_ROWS="500"

# Use true para certificacao: qualquer check skipped-small-dataset falha.
PERFORMANCE_REQUIRE_REPRESENTATIVE="false"

# ==============================================================================
# Restore drill operacional (somente job manual/checklist)
# ==============================================================================

RESTORE_DRILL_CONFIRMED_AT=""
RESTORE_DRILL_SOURCE_BRANCH=""
RESTORE_DRILL_RESTORE_BRANCH=""
RESTORE_DRILL_VALIDATED_BY=""

# ==============================================================================
# Certificacao operacional de producao (somente job manual/checklist)
# ==============================================================================

PRODUCTION_CERT_ADMIN_VERCEL_AUTH_AT=""
PRODUCTION_CERT_INNGEST_SYNC_AT=""
PRODUCTION_CERT_INNGEST_RECONCILE_CRON="0 4 * * *"
PRODUCTION_CERT_MANUAL_BILLING_SLA_HOURS=""
PRODUCTION_CERT_MANUAL_BILLING_SOP_AT=""
PRODUCTION_CERT_PROVIDER_SANDBOX_AT=""
PRODUCTION_CERT_QUERY_PLAN_AT=""
PRODUCTION_CERT_R2_HEALTH_AT=""
PRODUCTION_CERT_RESTORE_DRILL_AT=""
PRODUCTION_CERT_RLS_FORCED_TABLES=""
PRODUCTION_CERT_SENTRY_ALERT_AT=""
PRODUCTION_CERT_SENTRY_EVENT_ID=""
PRODUCTION_CERT_UPSTASH_RATE_LIMIT_AT=""
PRODUCTION_CERT_VALIDATED_BY=""

# ==============================================================================
# Smoke HTTP de deploy promovido (opcional)
# ==============================================================================

# URL publica do deploy a validar com `bun run deploy:smoke`.
# O smoke checa /api/health, /sign-in, redirect Google OAuth e bootstrap interno 403.
DEPLOYMENT_SMOKE_URL=""

# URL do deploy admin a validar com `bun run deploy:smoke:admin`.
# Quando Vercel Authentication bloquear a URL sem sessao, use
# ADMIN_DEPLOYMENT_SMOKE_PROTECTED=true para validar a barreira de protecao.
ADMIN_DEPLOYMENT_SMOKE_URL=""
ADMIN_DEPLOYMENT_SMOKE_PROTECTED="false"

# ==============================================================================
# Autenticação (Better Auth)
# ==============================================================================

# URL base do Better Auth (deve apontar para a mesma URL da aplicação localmente)
BETTER_AUTH_URL="http://localhost:3000"

# Segredo para encriptação de sessões (Gere com: `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Chave do Better Auth Infrastructure para Dashboard e Sentinel
BETTER_AUTH_API_KEY=""

# ------------------------------------------------------------------------------
# Google OAuth (Login com Google)
# Crie credenciais em: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ==============================================================================
# Storage / Armazenamento (Cloudflare R2)
# Configurações para upload e gerenciamento de arquivos
# ==============================================================================

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_STAGING=""
R2_BUCKET_PUBLIC=""
# URL pública base para acessar os arquivos do bucket
R2_PUBLIC_BASE_URL=""

# ==============================================================================
# Rate Limit (Upstash Redis)
# Rate limit distribuído para ambientes SaaS/serverless
# Obtenha as credenciais em: https://console.upstash.com/redis
# ==============================================================================

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# Tarefas Agendadas e Rotinas Internas (Cron/Webhooks)
# ==============================================================================

# Segredo para diagnostico interno do R2
INTERNAL_R2_HEALTH_SECRET=""

# Segredo para reconciliacao interna de imagens de produto
PRODUCT_IMAGE_RECONCILE_SECRET=""

# Segredo para chamadas internas de inicialização (bootstrap)
INTERNAL_BOOTSTRAP_SECRET=""

# Nunca use em produção real; somente E2E com banco isolado
ALLOW_PLAYWRIGHT_BOOTSTRAP="false"

# ==============================================================================
# Admin interno
# ==============================================================================

# Proteja o projeto Vercel do admin com Vercel Authentication/deployment
# protection. Essa protecao e configurada na Vercel, nao por variaveis do app.

# Variaveis usadas somente ao rodar `bun run platform-admin:bootstrap`.
# Use DATABASE_URL_DIRECT apontando para a branch correta e registre o motivo no runbook.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_NAME=""
PLATFORM_ADMIN_ROLE="owner"
PLATFORM_ADMIN_BOOTSTRAP_REASON=""

# ==============================================================================
# Emails transacionais (Resend)
# ==============================================================================

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Polaris <onboarding@resend.dev>"
RESEND_WEBHOOK_SECRET=""

# Email humano exibido para ativacao de assinatura, suporte e pedidos LGPD.
# Obrigatorio em producao.
SUPPORT_EMAIL="suporte@example.com"

# ==============================================================================
# Billing Pix recorrente (Woovi)
# ==============================================================================

WOOVI_API_BASE_URL="https://api.woovi.com"
WOOVI_API_KEY=""
WOOVI_WEBHOOK_SECRET=""

# ==============================================================================
# Billing cartao recorrente (Asaas)
# ==============================================================================

ASAAS_API_BASE_URL="https://api.asaas.com/v3"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""

# ==============================================================================
# Monitoramento e Erros (Sentry)
# Opcional em ambiente de desenvolvimento (dev); recomendado em produção
# ==============================================================================

SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Sampling opcional. Valores inválidos caem nos padrões seguros.
SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=""

# ==============================================================================
# Jobs duraveis (Inngest)
# ==============================================================================

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

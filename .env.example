# ==============================================================================
# Polaris environment contract
# Copy to .env.local and fill values for local development.
# Never commit .env.local or files with real secrets.
#
# Labels:
# - [required:local] needed for the normal local app.
# - [required:prod] needed only in production or production certification.
# - [optional] safe to leave empty unless using that integration/operation.
# - [generated] normally provided by Vercel/CI; do not set locally unless testing.
# ==============================================================================

# ==============================================================================
# Runtime and canonical URLs
# ==============================================================================

# [required:local] App runtime: development, test, production.
# Local default: development.
NODE_ENV="development"

# [generated] Vercel runtime environment: development, preview, production.
# Where: Vercel system variable; confirm system-variable exposure in project settings.
# Every Preview is non-production for billing API host validation. Scope any
# Sandbox credentials to the persistent Staging target after P4 is configured.
VERCEL_ENV=""

# [optional] Canonical app URL mode.
# Values: empty/local, public, tunnel.
# Local default resolves to APP_LOCAL_URL. Use tunnel only when exposing local dev.
APP_URL_MODE=""

# [optional] Local canonical app origin used in development/test.
APP_LOCAL_URL="http://localhost:3000"

# [optional] Public canonical app origin for preview/prod/tunnel.
# Where: Vercel project domain, custom domain, ngrok, or Cloudflare Tunnel URL.
APP_PUBLIC_URL=""

# [required:local] Public app origin fallback and compatibility variable.
# In runtime this is normalized to the canonical app origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [optional] Admin app origin. In production this must be a separate origin.
# Where: Vercel admin project domain or custom admin domain.
ADMIN_APP_URL=""

# ==============================================================================
# Database - Neon Postgres
# ==============================================================================

# [required:local] Runtime database URL.
# Where: Neon Console > Project > Connection string > Pooled connection.
# Production: use a non-owner runtime role without BYPASSRLS and sslmode=verify-full.
DATABASE_URL=""

# [optional] Runtime pg.Pool max size per server instance.
# Default in code is conservative. Keep low in serverless.
DATABASE_POOL_MAX=""

# [required:local] Direct database URL for migrations and admin scripts.
# Where: Neon Console > Connection string > Direct connection.
# Production: use migration/admin role and sslmode=verify-full.
DATABASE_URL_DIRECT=""

# [optional:local] Dedicated disposable PostgreSQL scratch URL for db:push only.
# Must use localhost, 127.0.0.1, or ::1 and database polaris_push_scratch.
# Keep empty unless a throwaway local PostgreSQL instance is available; never use Neon here.
DATABASE_URL_PUSH_LOCAL=""

# [required:verify] Disposable loopback-only database for full verification.
# Must be separate from DATABASE_URL. Never use a remote or production database.
POSTGRES_BEHAVIOR_DATABASE_URL=""

# [optional] Isolated database URL for Playwright/E2E. Normal app startup does
# not need it; Playwright requires it. CI uses E2E_DATABASE_URL for Web and
# ADMIN_E2E_DATABASE_URL for Admin; both are injected as E2E_DATABASE_URL.
# Never point this at production.
E2E_DATABASE_URL=""

# [optional] Runtime role URL for RLS smoke checks.
# Must use a non-owner role without BYPASSRLS.
RLS_DATABASE_URL=""

# ==============================================================================
# Better Auth and Google OAuth
# ==============================================================================

# [required:local] Better Auth base origin fallback.
# In runtime this is normalized to the same canonical app origin as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"

# [required:local] Better Auth session/encryption secret.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# [optional] Better Auth Infrastructure API key for Dashboard/Sentinel.
# Where: Better Auth Infrastructure dashboard.
BETTER_AUTH_API_KEY=""

# [optional] Google OAuth web client ID.
# Required for real Google login.
# Where: Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=""

# [optional] Google OAuth web client secret.
# Where: Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_SECRET=""

# [optional] Public Google client ID. Must match GOOGLE_CLIENT_ID in production.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# [required:prod] Dedicated Better Auth secret for the admin app.
# Local development may temporarily fall back to BETTER_AUTH_SECRET, but production must use this distinct value.
# Generate: openssl rand -base64 32
ADMIN_BETTER_AUTH_SECRET=""

# [required:prod] Dedicated Google OAuth client for the admin app. Never reuse the tenant web client.
# Redirect URIs: http://localhost:3001/api/auth/callback/google and https://<admin-domain>/api/auth/callback/google
ADMIN_GOOGLE_CLIENT_ID=""
ADMIN_GOOGLE_CLIENT_SECRET=""

# ==============================================================================
# Internal auth/bootstrap controls
# ==============================================================================

# [optional] Internal bootstrap route secret for dev/E2E.
# Generate: openssl rand -base64 32
INTERNAL_BOOTSTRAP_SECRET=""

# [optional] Allow Playwright to bootstrap sessions in development/test only.
ALLOW_PLAYWRIGHT_BOOTSTRAP="false"


# ==============================================================================
# Cloudflare R2 product images
# ==============================================================================

# [optional] R2 account ID.
# Where: Cloudflare Dashboard > R2 or account overview.
R2_ACCOUNT_ID=""

# [optional] R2 access key ID with access to staging/final buckets.
# Where: Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_ACCESS_KEY_ID=""

# [optional] R2 secret access key.
# Where: Cloudflare Dashboard > R2 > Manage R2 API Tokens.
R2_SECRET_ACCESS_KEY=""

# [optional] R2 staging bucket name for uploads before reconciliation.
R2_BUCKET_STAGING=""

# [optional] R2 final bucket name for served product images.
R2_BUCKET_FINAL=""

# [optional] Public base URL for final images.
# Where: R2 public custom domain or public bucket URL.
R2_PUBLIC_BASE_URL=""

# [optional] Secret for internal R2 health endpoint.
# Required in Vercel production. Generate: openssl rand -base64 32
INTERNAL_R2_HEALTH_SECRET=""

# [optional] Secret for internal product image reconciliation endpoint.
# Required in Vercel production. Generate: openssl rand -base64 32
PRODUCT_IMAGE_RECONCILE_SECRET=""

# ==============================================================================
# Upstash Redis rate limiting
# ==============================================================================

# [optional] Upstash Redis REST URL.
# Where: Upstash Console > Redis database > REST API.
UPSTASH_REDIS_REST_URL=""

# [optional] Upstash Redis REST token.
# Where: Upstash Console > Redis database > REST API.
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# Emails - Resend
# ==============================================================================

# [optional] Resend API key for transactional email.
# Where: Resend Dashboard > API Keys.
RESEND_API_KEY=""

# [optional] Sender identity. In production use a verified domain.
# Where: Resend Dashboard > Domains.
RESEND_FROM_EMAIL="Polaris <onboarding@resend.dev>"

# [optional] Resend webhook signing secret.
# Where: Resend Dashboard > Webhooks.
RESEND_WEBHOOK_SECRET=""

# [required:prod] Human support/LGPD contact email shown to users.
SUPPORT_EMAIL="suporte@example.com"

# ==============================================================================
# Billing - Woovi Pix
# ==============================================================================

# [optional] Woovi Sandbox API base URL. Production hosts are rejected outside
# Vercel Production.
WOOVI_API_BASE_URL="https://api.woovi-sandbox.com"

# [optional] Woovi API key.
# Where: Woovi dashboard/API credentials.
WOOVI_API_KEY=""

# [optional] Woovi webhook secret.
# Where: Woovi dashboard webhook configuration.
WOOVI_WEBHOOK_SECRET=""

# ==============================================================================
# Billing - Asaas card
# ==============================================================================

# [optional] Asaas API base URL. Sandbox/Production credentials are distinct.
# Production hosts are rejected outside Vercel Production.
# Sandbox: https://api-sandbox.asaas.com/v3
# Production: https://api.asaas.com/v3
ASAAS_API_BASE_URL="https://api-sandbox.asaas.com/v3"

# [optional] Asaas API key.
# Where: Asaas dashboard/API credentials.
ASAAS_API_KEY=""

# [optional] Asaas webhook token.
# Where: Asaas webhook configuration.
ASAAS_WEBHOOK_TOKEN=""

# ==============================================================================
# Sentry monitoring
# ==============================================================================

# [optional] Server Sentry DSN.
# Where: Sentry project settings > Client Keys (DSN).
SENTRY_DSN=""

# [optional] Browser Sentry DSN.
# Where: Sentry project settings > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=""

# [optional] Sentry org slug for source map uploads.
SENTRY_ORG=""

# [optional] Sentry project slug for source map uploads.
SENTRY_PROJECT=""

# [optional] Sentry auth token for source map uploads.
# Where: Sentry Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=""

# ==============================================================================
# Durable jobs - Inngest
# ==============================================================================

# [optional] Inngest event key.
# Where: Inngest dashboard > app/env keys.
INNGEST_EVENT_KEY=""

# [optional] Inngest signing key.
# Where: Inngest dashboard > app/env keys.
INNGEST_SIGNING_KEY=""

# ==============================================================================
# Platform admin bootstrap script
# ==============================================================================

# [optional] Used only by: bun run platform-admin:bootstrap
PLATFORM_ADMIN_EMAIL=""

# [optional] Initial enrollment role. Default: owner.
PLATFORM_ADMIN_ROLE="owner"

# [optional] Audit reason recorded by bootstrap script.
PLATFORM_ADMIN_BOOTSTRAP_REASON=""

# [optional] First OAuth claim must occur before this number of days. Default: 7.
PLATFORM_ADMIN_ENROLLMENT_TTL_DAYS="7"

# [optional] Initial grant duration. Default: 90.
PLATFORM_ADMIN_GRANT_TTL_DAYS="90"

# ==============================================================================
# Deployment smoke tests
# ==============================================================================

# [optional] Public web deployment URL for: bun run deploy:smoke
DEPLOYMENT_SMOKE_URL=""

# [optional] Admin deployment URL for: bun run deploy:smoke:admin
ADMIN_DEPLOYMENT_SMOKE_URL=""

# [optional] Set true when Vercel Authentication blocks unauthenticated smoke.
ADMIN_DEPLOYMENT_SMOKE_PROTECTED="false"

# ==============================================================================
# Listing plan analysis
# ==============================================================================

# [optional] Tenant used by: bun run db:analyze:listings
PERFORMANCE_ORGANIZATION_ID=""

# [optional] Search term used by listing plan analysis.
PERFORMANCE_SEARCH_TERM=""

# [optional] app.user_id used by policies that depend on user context.
PERFORMANCE_USER_ID=""

# [optional] Minimum rows for representative query plans.
PERFORMANCE_MIN_ROWS="500"

# [optional] true makes skipped-small-dataset checks fail certification.
PERFORMANCE_REQUIRE_REPRESENTATIVE="false"

# ==============================================================================
# Restore drill checklist
# ==============================================================================

# [optional] Timestamp when restore drill was confirmed.
RESTORE_DRILL_CONFIRMED_AT=""

# [optional] Source branch restored from.
RESTORE_DRILL_SOURCE_BRANCH=""

# [optional] Restore branch created for drill.
RESTORE_DRILL_RESTORE_BRANCH=""

# [optional] Human/operator who validated the drill.
RESTORE_DRILL_VALIDATED_BY=""

# ==============================================================================
# Production certification checklist
# ==============================================================================

# [optional] Timestamp when admin Vercel Authentication was validated.
PRODUCTION_CERT_ADMIN_VERCEL_AUTH_AT=""

# [optional] true/false: admin app deploy includes files outside root when needed.
PRODUCTION_CERT_ADMIN_VERCEL_OUTSIDE_ROOT_INCLUDED=""

# [optional] Admin Vercel root directory that was validated.
PRODUCTION_CERT_ADMIN_VERCEL_ROOT_DIRECTORY=""

# [optional] Timestamp when Asaas sandbox was validated.
PRODUCTION_CERT_ASAAS_SANDBOX_AT=""

# [optional] Timestamp when Inngest sync was validated.
PRODUCTION_CERT_INNGEST_SYNC_AT=""

# [optional] Expected Inngest reconcile cron.
PRODUCTION_CERT_INNGEST_RECONCILE_CRON="0 4 * * *"

# [optional] Expected Inngest reconcile function ID.
PRODUCTION_CERT_INNGEST_RECONCILE_FUNCTION_ID="reconcile-product-images"

# [optional] Manual billing support SLA in hours.
PRODUCTION_CERT_MANUAL_BILLING_SLA_HOURS=""

# [optional] Timestamp when manual billing SOP was validated.
PRODUCTION_CERT_MANUAL_BILLING_SOP_AT=""

# [optional] true/false: Neon pooler enabled.
PRODUCTION_CERT_NEON_POOLER_ENABLED=""

# [optional] true/false: Neon production branch protected.
PRODUCTION_CERT_NEON_PRODUCTION_BRANCH_PROTECTED=""

# [optional] Timestamp when provider sandbox checks passed.
PRODUCTION_CERT_PROVIDER_SANDBOX_AT=""

# [optional] Timestamp when representative query plan check passed.
PRODUCTION_CERT_QUERY_PLAN_AT=""

# [optional] Minimum rows for production query plan certification.
PRODUCTION_CERT_QUERY_PLAN_MIN_ROWS="500"

# [optional] Search term for production query plan certification.
PRODUCTION_CERT_QUERY_PLAN_SEARCH_TERM=""

# [optional] Timestamp when R2 health was validated.
PRODUCTION_CERT_R2_HEALTH_AT=""

# [optional] Timestamp when restore drill was validated for production.
PRODUCTION_CERT_RESTORE_DRILL_AT=""

# [optional] Restore drill source branch for production certification.
PRODUCTION_CERT_RESTORE_DRILL_SOURCE_BRANCH="production"

# [optional] Restore drill restore branch for production certification.
PRODUCTION_CERT_RESTORE_DRILL_RESTORE_BRANCH=""

# [optional] Comma-separated tables with forced RLS.
PRODUCTION_CERT_RLS_FORCED_TABLES=""

# [optional] Timestamp when Sentry alerting was validated.
PRODUCTION_CERT_SENTRY_ALERT_AT=""

# [optional] Sentry event ID used as certification evidence.
PRODUCTION_CERT_SENTRY_EVENT_ID=""

# [optional] Timestamp when Upstash rate limiting was validated.
PRODUCTION_CERT_UPSTASH_RATE_LIMIT_AT=""

# [optional] Human/operator who validated production readiness.
PRODUCTION_CERT_VALIDATED_BY=""

# [optional] Timestamp when Woovi sandbox was validated.
PRODUCTION_CERT_WOOVI_SANDBOX_AT=""
